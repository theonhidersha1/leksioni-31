<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Numbers from 1 to 10</title>
</head>
<body>

    <h2>Numbers from 1 to 10</h2>
    <div id="numbers"></div>

    <script>
        let output = "";

        for (let i = 1; i <= 10; i++) {
            output += i + "<br>";
        }

        document.getElementById("numbers").innerHTML = output;
    </script>

</body>
</html>
